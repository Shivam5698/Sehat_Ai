{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "outDir": "dist",
    "rootDir": "../../../../",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "noImplicitAny": true,
    "noEmitOnError": true
  },
  "include": ["src/**/*", "../../../../../../shared/agent-registry/**/*"],
  "exclude": ["node_modules", "dist", "tests"]
}
